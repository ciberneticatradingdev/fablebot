# ── fablebot config ───────────────────────────────────────────────
# Everything is optional: with no keys the bot boots in DEMO mode
# (brain, wallet, and X all faked) so you can watch it work first.

# --- brain ---
ANTHROPIC_API_KEY=            # Claude key. Empty = demo brain.
MODEL=claude-fable-5          # the brain — fablebot runs on Fable 5
CONSOLIDATE_MODEL=claude-fable-5              # memory compaction (same model)
MAX_STEPS_PER_TICK=8          # max tool-use steps per wake-up

# --- run loop ---
ENABLED=true                  # master kill switch. false = server up but bot won't act.
TICK_MINUTES=3                # how often fablebot wakes up
PORT=8947

# --- wallet (its own burner) ---
WALLET_PRIVATE_KEY=           # base58 secret key. Empty = demo wallet (no real tx).
RPC_URL=https://api.mainnet-beta.solana.com
LIVE=false                    # false = every on-chain action is simulated (dry run). Flip to true to spend.

# --- spend guardrails (enforced in code) ---
MAX_SOL_PER_ACTION=0.2
MAX_SOL_PER_DAY=0.5

# --- X / Twitter ---
# posting (official API v2, OAuth 1.0a user context):
X_APP_KEY=
X_APP_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
MAX_TWEETS_PER_DAY=16
# reading mentions/topics (twitterapi.io, cheap):
TWITTERAPI_KEY=

# --- livestream chat (stream/chat/poller.mjs, separate process) ---
COIN_MINT=                    # your coin mint = the pump.fun chat room id
PUMP_CHAT_TOKEN=              # auth token to SEND chat. Empty = read-only (bot still speaks via voice).
PUMP_CHAT_USERNAME=fablebot

# --- stream rig (stream/stream.sh, separate process) ---
# RTMP_URL=
# STREAM_KEY=
